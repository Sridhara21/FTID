{
  "entities": {
    "Citizen": {
      "title": "Citizen",
      "description": "Sovereign identity profile with institutional bonding metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "pan": {
          "type": "object",
          "properties": {
            "number": { "type": "string" },
            "status": { "type": "string", "enum": ["Verified", "Pending"] }
          }
        },
        "aadhaar": {
          "type": "object",
          "properties": {
            "number": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "currentCreditScore": { "type": "number", "description": "FTID Flow Score" },
        "isLinked": { "type": "boolean" },
        "registrationDate": { "type": "string", "format": "date-time" },
        "onboardingComplete": { "type": "boolean" }
      },
      "required": ["id", "fullName", "email", "pan", "aadhaar"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Verified financial flow record used for spending analysis and tax estimation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "citizenId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["tax_payment", "subsidy", "cbdc_transfer", "essential", "discretionary"] },
        "status": { "type": "string" },
        "classification": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "originInstitution": { "type": "string" },
        "destinationInstitution": { "type": "string" }
      }
    },
    "Investment": {
      "title": "Investment",
      "description": "Bonded asset record for portfolio tracking and capital gains analysis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Stock", "Mutual Fund", "FD", "Bond", "Gold"] },
        "value": { "type": "number" },
        "taxClass": { "type": "string", "enum": ["LTCG", "STCG", "Exempt"] }
      }
    },
    "TaxRecord": {
      "title": "TaxRecord",
      "description": "Institutional income and deduction data used for real-time tax calculation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["Income", "Deduction"] },
        "source": { "type": "string" },
        "amount": { "type": "number" },
        "verified": { "type": "boolean" },
        "fy": { "type": "string" }
      }
    }
  },
  "seedingRequirements": {
    "purpose": "To generate 50-100 live-prototype personas accessible via specific Aadhaar/PAN keys.",
    "fieldsRequired": {
      "profile": ["fullName", "email", "pan_number", "aadhaar_number"],
      "finance": ["monthly_income", "avg_expenses", "savings_ratio"],
      "transactions": ["date", "description", "amount", "category", "institution"],
      "portfolio": ["asset_name", "type", "market_value", "qty"],
      "tax": ["salary_income", "standard_deductions", "section_80c", "section_80d"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/citizens/{citizenId}": {
      "schema": { "$ref": "#/backend/entities/Citizen" },
      "description": "Primary identity node."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/backend/entities/Transaction" },
      "description": "Global transaction DNS flows."
    },
    "/citizens/{citizenId}/investments/{id}": {
      "schema": { "$ref": "#/backend/entities/Investment" },
      "description": "Private asset portfolio."
    },
    "/citizens/{citizenId}/taxRecords/{id}": {
      "schema": { "$ref": "#/backend/entities/TaxRecord" },
      "description": "Sovereign tax intelligence."
    }
  }
}
