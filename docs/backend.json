
{
  "entities": {
    "Citizen": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Citizen",
      "type": "object",
      "description": "Represents an individual user (citizen) of the FTID system, managing their personal financial data and interactions with government entities.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Citizen entity (Firebase UID)."
        },
        "fullName": {
          "type": "string",
          "description": "The full legal name of the citizen."
        },
        "email": {
          "type": "string",
          "description": "The primary email address of the citizen.",
          "format": "email"
        },
        "pan": {
          "type": "object",
          "properties": {
            "number": { "type": "string" },
            "status": { "type": "string", "enum": ["Verified", "Pending", "Unlinked"] }
          }
        },
        "aadhaar": {
          "type": "object",
          "properties": {
            "number": { "type": "string" },
            "status": { "type": "string", "enum": ["Verified", "Pending", "Unlinked"] }
          }
        },
        "isLinked": {
          "type": "boolean",
          "description": "True if sovereign identity is bonded to FTID."
        },
        "registrationDate": {
          "type": "string",
          "format": "date-time"
        },
        "currentCreditScore": {
          "type": "number",
          "description": "The citizen's current Flow Score."
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "fullName",
        "email",
        "currentCreditScore"
      ]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Core financial DNS log record representing a movement of value.",
      "properties": {
        "id": { "type": "string" },
        "citizenId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["tax_payment", "subsidy_disbursement", "cbdc_transfer", "utility", "retail"] },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "originInstitution": { "type": "string" },
        "destinationInstitution": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "blockchainHash": { "type": "string" },
        "classification": { "type": "string" }
      },
      "required": ["id", "citizenId", "amount", "type", "status", "timestamp"]
    },
    "FraudAlert": {
      "title": "FraudAlert",
      "type": "object",
      "description": "Anomalies detected in financial flows using AI velocity analysis.",
      "properties": {
        "id": { "type": "string" },
        "location": { "type": "string" },
        "riskLevel": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "reason": { "type": "string" },
        "detectionDate": { "type": "string", "format": "date-time" },
        "governmentEntityId": { "type": "string" }
      }
    },
    "SubsidyProgram": {
      "title": "SubsidyProgram",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "allocationCr": { "type": "number" },
        "sourceMinistry": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "PoliticalDonation": {
      "title": "PoliticalDonation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "donorCitizenId": { "type": "string" },
        "donorName": { "type": "string" },
        "recipientParty": { "type": "string" },
        "amount": { "type": "number" },
        "electionId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/citizens/{citizenId}",
        "definition": {
          "entityName": "Citizen",
          "schema": { "$ref": "#/backend/entities/Citizen" },
          "description": "Private citizen profile and identity data."
        }
      },
      {
        "path": "/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": { "$ref": "#/backend/entities/Transaction" },
          "description": "Global financial DNS flow records."
        }
      },
      {
        "path": "/fraudAlerts/{alertId}",
        "definition": {
          "entityName": "FraudAlert",
          "schema": { "$ref": "#/backend/entities/FraudAlert" },
          "description": "Anomalies detected in financial flows."
        }
      },
      {
        "path": "/subsidyPrograms/{programId}",
        "definition": {
          "entityName": "SubsidyProgram",
          "schema": { "$ref": "#/backend/entities/SubsidyProgram" },
          "description": "Government welfare program configurations."
        }
      },
      {
        "path": "/politicalDonations/{donationId}",
        "definition": {
          "entityName": "PoliticalDonation",
          "schema": { "$ref": "#/backend/entities/PoliticalDonation" },
          "description": "Public transparency records for political funding."
        }
      }
    ]
  }
}
