
{
  "entities": {
    "Citizen": {
      "title": "Citizen",
      "description": "Sovereign identity profile with institutional bonding metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "pan": {
          "type": "object",
          "properties": {
            "number": { "type": "string" },
            "status": { "type": "string", "enum": ["Verified", "Pending"] }
          }
        },
        "aadhaar": {
          "type": "object",
          "properties": {
            "number": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "currentCreditScore": { "type": "number", "description": "FTID Flow Score" },
        "tier": { "type": "string", "enum": ["Tier1", "Tier2", "Tier3_Rural"] },
        "persona": { "type": "string" },
        "isLinked": { "type": "boolean" },
        "registrationDate": { "type": "string", "format": "date-time" },
        "onboardingComplete": { "type": "boolean" }
      },
      "required": ["id", "fullName", "email", "pan", "aadhaar"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Verified financial flow record used for spending analysis and tax estimation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "citizenId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "classification": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "originInstitution": { "type": "string" },
        "destinationInstitution": { "type": "string" },
        "channel": { "type": "string" }
      }
    },
    "Investment": {
      "title": "Investment",
      "description": "Bonded asset record for portfolio tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "taxClass": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/citizens/{citizenId}": {
      "schema": { "$ref": "#/backend/entities/Citizen" },
      "description": "Sovereign identity nodes."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/backend/entities/Transaction" },
      "description": "Global transaction ledger."
    },
    "/citizens/{citizenId}/investments/{id}": {
      "schema": { "$ref": "#/backend/entities/Investment" },
      "description": "Bonded assets."
    }
  }
}
