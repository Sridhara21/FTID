
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FTID (Financial Transparency & Identity) Security Rules
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a robust security model based on User Ownership and Database-Backed Access Control (DBAC).
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Combined existence and ownership check for update/delete
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // Checks if the user is a global platform administrator
    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // --- Rules ---

    /**
     * @description Collection for system-wide platform administrators.
     * @path /platformAdmins/{platformAdminId}
     */
    match /platformAdmins/{platformAdminId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)));
    }

    /**
     * @description Stores individual citizen profiles.
     * @path /citizens/{citizenId}
     */
    match /citizens/{citizenId} {
      allow get, list: if isOwner(citizenId) || isPlatformAdmin();
      allow create: if isOwner(citizenId) && request.resource.data.id == citizenId;
      allow update: if isExistingOwner(citizenId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();

      match /financialTips/{id} {
        allow read, write: if isOwner(citizenId);
      }
      match /investments/{id} {
        allow read, write: if isOwner(citizenId) || isPlatformAdmin();
      }
    }

    /**
     * @description Financial transactions between citizens and government.
     * @path /transactions/{transactionId}
     */
    match /transactions/{transactionId} {
      // Platform Admins can see everything.
      // Citizens can only list documents where they are the owner.
      allow list: if isPlatformAdmin() || (isSignedIn() && resource.data.citizenId == request.auth.uid);
      allow get: if isPlatformAdmin() || (isSignedIn() && resource.data.citizenId == request.auth.uid);
      
      allow create: if isOwner(request.resource.data.citizenId) || isPlatformAdmin();
      allow update, delete: if isPlatformAdmin();
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if isPlatformAdmin();
    }
  }
}
