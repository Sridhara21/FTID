
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FTID (Financial Transparency & Identity) Security Rules
     * Optimized for ownership-based isolation and administrative oversight.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the user exists in the platformAdmins collection
    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // --- Rules ---

    /**
     * @description Collection for system-wide platform administrators.
     */
    match /platformAdmins/{platformAdminId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)));
    }

    /**
     * @description Stores individual citizen profiles.
     */
    match /citizens/{citizenId} {
      allow get: if isOwner(citizenId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create: if isOwner(citizenId);
      allow update: if isOwner(citizenId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();

      match /financialTips/{id} {
        allow read, write: if isOwner(citizenId);
      }
      match /investments/{id} {
        allow read, write: if isOwner(citizenId) || isPlatformAdmin();
      }
    }

    /**
     * @description Financial transactions ledger.
     */
    match /transactions/{transactionId} {
      // For List operations, ensure users only query their own data OR are admins.
      // This is enforced by including the citizenId filter in queries.
      allow list: if isSignedIn() && (
        isPlatformAdmin() || 
        (resource.data.citizenId == request.auth.uid && ("limit" in request.query ? request.query.limit <= 1000 : true))
      );
      
      allow get: if isSignedIn() && (
        isPlatformAdmin() || 
        resource.data.citizenId == request.auth.uid
      );
      
      allow create: if isSignedIn() && (
        request.resource.data.citizenId == request.auth.uid || 
        isPlatformAdmin()
      );
      
      allow update, delete: if isPlatformAdmin();
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if isPlatformAdmin();
    }
  }
}
